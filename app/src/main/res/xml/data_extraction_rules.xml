<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="queued_audio/" />
        <exclude domain="root" path="no_backup/queued_audio/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="queued_audio/" />
        <exclude domain="root" path="no_backup/queued_audio/" />
    </device-transfer>
</data-extraction-rules>
